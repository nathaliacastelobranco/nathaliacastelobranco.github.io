---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Ava from 'public/profile-photo.jpeg';
import Prose from '../components/Prose.astro';

---

<BaseLayout
	title="About Me"
	description="Lorem ipsum dolor sit amet"
>
  <div class='container'>
		<main class='prose text-lg dark:prose-invert'>
      <article>
        <div class='w-full md:flex md:items-center gap-16 mb-10'>
          <div class="text-pretty leading-9">
            <h1 class="text-4xl font-bold mb-4">Hi, I'm Nathalia 👋</h1>
            <Prose>
              <div class="text-lg">
                <p>I'm a Software Engineer with a background in data and AI. I enjoy working across the full stack — from infrastructure and integrations to the interfaces people actually use.</p>
                <p>Before moving into software engineering, I worked with data pipelines, machine learning models, and AI applications. That background still shapes how I think about the products I build.</p>  
                <p>Here you'll find my projects, some writing about things I'm learning, and a bit about how I got here.</p>
           </div>
            </Prose>
          </div>
          <Image src={Ava} alt="Nathalia Castelo Branco" width={300}  class="rounded-3xl rotate-3 mx-4 md:mx-0"/>
        </div>     
        <div>
          

        
        </div>
        </article>
      </article>
    </main>
  </div>
</BaseLayout>
