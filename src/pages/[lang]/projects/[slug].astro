---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { t } from '../../../i18n.ts';
import { projects } from '../../../data/projects.ts';
import { SITE_TITLE } from '../../../consts';

export function getStaticPaths() {
	const langs = ['en', 'pt-br'] as const;
	return langs.flatMap((lang) =>
		projects.map((project) => ({
			params: { lang, slug: project.slug },
			props: { project },
		}))
	);
}

const { lang } = Astro.params;
const { project } = Astro.props;
const copy = project.copy[lang as 'en' | 'pt-br'];
const placeholderLabel = lang === 'pt-br' ? 'Imagem principal do projeto' : 'Main project image';

const labels = {
	en: { back: '← Back to projects', stack: 'Stack', role: 'Role', period: 'Period', problem: 'The problem', approach: 'The approach', result: 'Result', repo: 'Repository', demo: 'Live demo' },
	'pt-br': { back: '← Voltar aos projetos', stack: 'Stack', role: 'Papel', period: 'Período', problem: 'O problema', approach: 'A abordagem', result: 'Resultado', repo: 'Repositório', demo: 'Demo ao vivo' },
}[lang as 'en' | 'pt-br'];
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={`${copy.title} · ${SITE_TITLE}`} description={copy.description} />
	</head>
	<body>
		<Header lang={lang} />
		<main class="project-main">
			<a href={`/${lang}/#projects`} class="back-link mono">{labels.back}</a>

			<div class="project-heading">
				<div>
					<div class="project-tags">
						{project.tags.map((tag) => <span class="tag tag--cyan">{tag}</span>)}
					</div>
					<h1>{copy.title}</h1>
				</div>
				<div class="project-actions mono">
					{project.repoUrl && <a href={project.repoUrl} class="btn btn--secondary" target="_blank" rel="noopener noreferrer">{labels.repo}</a>}
					{project.demoUrl && <a href={project.demoUrl} class="btn btn--primary" target="_blank" rel="noopener noreferrer">{labels.demo}</a>}
				</div>
			</div>

			<div class="project-hero-image" role="img" aria-label={placeholderLabel}>{placeholderLabel}</div>

			<div class="project-content">
				<aside class="project-meta">
					<div>
						<div class="meta-label mono">{labels.stack}</div>
						<div class="meta-tags">
							{project.stack.map((item) => <span class="tag">{item}</span>)}
						</div>
					</div>
					<div>
						<div class="meta-label mono">{labels.role}</div>
						<div class="meta-value">{copy.role}</div>
					</div>
					<div>
						<div class="meta-label mono">{labels.period}</div>
						<div class="meta-value">{copy.period}</div>
					</div>
				</aside>

				<div class="project-body prose">
					<h2>{labels.problem}</h2>
					<p>{copy.problem}</p>

					<h2>{labels.approach}</h2>
					<p>{copy.approach}</p>

					<h2>{labels.result}</h2>
					<p>{copy.result}</p>
				</div>
			</div>
		</main>
		<Footer lang={lang} />
	</body>
</html>

<style>
	.project-main {
		width: 960px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: 56px 1em 100px;
	}

	.back-link {
		font-size: 13px;
		color: var(--text-dim);
	}

	.project-heading {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 32px;
		flex-wrap: wrap;
		margin: 28px 0 36px;
	}

	.project-tags {
		display: flex;
		gap: 8px;
		margin-bottom: 18px;
	}

	.project-heading h1 {
		font-size: 2.4em;
		margin: 0;
	}

	.project-actions {
		display: flex;
		gap: 12px;
	}

	.project-hero-image {
		width: 100%;
		height: 320px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--bg-panel);
		border: 1px solid var(--border);
		border-radius: 4px;
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--text-faint);
		margin-bottom: 48px;
	}

	.project-content {
		display: grid;
		grid-template-columns: 200px 1fr;
		gap: 48px;
	}

	.project-meta {
		display: flex;
		flex-direction: column;
		gap: 28px;
	}

	.meta-label {
		font-size: 12px;
		color: var(--text-dim);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin-bottom: 10px;
	}

	.meta-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.meta-value {
		font-size: 14px;
		color: var(--text-muted);
	}

	.project-body h2 {
		font-size: 1.3em;
		margin: 0 0 14px;
	}

	.project-body p {
		color: var(--text-muted);
	}

	@media (max-width: 720px) {
		.project-content {
			grid-template-columns: 1fr;
		}
	}
</style>
