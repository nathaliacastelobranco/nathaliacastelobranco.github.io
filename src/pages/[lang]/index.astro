---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Profile from '../../components/Profile.astro';
import Projects from '../../components/Projects.astro';
import BlogPreview from '../../components/BlogPreview.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

export function getStaticPaths() {
  return [
    { params: { lang: "en" }},
    { params: { lang: "pt-br" }},
  ];
}

const { lang } = Astro.params as { lang: 'en' | 'pt-br' };
---

<!doctype html>
<html lang={ lang }>
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} lang={lang} />
	</head>
	<body>
		<div class="scanline-overlay"></div>
		<Header lang={ lang } />
		<main>
			<Profile lang={ lang } />
			<Projects lang={ lang } />
			<BlogPreview lang={ lang } />
		</main>
		<Footer lang={ lang } />
	</body>
</html>

<style>
	/* global.css sets a 720px reading width on <main> for the blog/prose
	   pages; the homepage sections manage their own (wider) widths via
	   .hero/.section, so undo that constraint here. */
	main {
		width: 100%;
		max-width: none;
		margin: 0;
		padding: 0;
	}
</style>
