---
// The "About" content now lives as a section on the home page (#about).
// This route is kept so old links/bookmarks still resolve.
export function getStaticPaths() {
  return [
    { params: { lang: "en" }},
    { params: { lang: "pt-br" }},
  ];
}

const { lang } = Astro.params;
const redirectUrl = `/${lang}/#about`;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta http-equiv="refresh" content={`0;url=${redirectUrl}`}>
  <title>Redirecting...</title>
</head>
<body>
  <p>Redirecting to <a href={redirectUrl}>the site</a>...</p>
</body>
</html>
