---
interface Props {
  lang: string;
}

const { lang } = Astro.props;

const content = {
  'en': {
    eyebrow: '// data scientist & python developer',
    jobTitle: 'Data Scientist & Python Developer',
    summary: "I'm an engineer passionate about Artificial Intelligence, with a strong focus on NLP, with hands-on experience applying AI to solve complex problems, generate insights, and build innovative solutions. I work at the intersection of data, language, and technology, always aiming for real-world impact through automation and applied intelligence.",
    ctaPrimary: 'View projects',
    ctaSecondary: 'Get in touch',
    photoAlt: 'Nathalia Castelo Branco',
    aboutEyebrow: '01 / about',
    aboutTitle: 'About me',
    techTitle: 'Main Technologies',
    certifications: 'Certifications'
  },
  'pt-br': {
    eyebrow: '// cientista de dados & desenvolvedora python',
    jobTitle: 'Cientista de Dados & Desenvolvedora Python',
    summary: 'Engenheira apaixonada por Inteligência Artificial, com foco especial em NLP, tenho experiência prática aplicando IA para resolver problemas complexos, gerar insights e construir soluções inovadoras. Atuo na interseção entre dados, linguagem e tecnologia, sempre buscando impacto real por meio de automação e inteligência aplicada.',
    ctaPrimary: 'Ver projetos',
    ctaSecondary: 'Falar comigo',
    photoAlt: 'Nathalia Castelo Branco',
    aboutEyebrow: '01 / sobre',
    aboutTitle: 'Quem sou eu',
    techTitle: 'Principais Tecnologias',
    certifications: 'Certificações'
  }
};

const c = content[lang as keyof typeof content] || content['en'];
const techs = ['Python', 'SQL', 'Google Cloud', 'Vector Databases', 'Streamlit'];
---

<section id="home" class="hero">
  <div class="hero-ring hero-ring--pink"></div>
  <div class="hero-ring hero-ring--cyan"></div>
  <div class="hero-copy">
    <div class="eyebrow eyebrow--pink mono">{c.eyebrow}</div>
    <h1>Nathalia<br />Castelo Branco</h1>
    <p class="hero-desc">{c.summary}</p>
    <div class="hero-ctas">
      <a href="#projects" class="btn btn--primary">{c.ctaPrimary}</a>
      <a href="#contact" class="btn btn--secondary">{c.ctaSecondary}</a>
    </div>
    <div class="hero-tags">
      {techs.map((tech) => <span class="tag">{tech}</span>)}
    </div>
  </div>
  <div class="hero-photo">
    <div class="hero-photo-dashed"></div>
    <img src="/profile-photo.jpeg" alt={c.photoAlt} />
  </div>
</section>

<section id="about" class="section about">
  <div class="about-heading">
    <div class="eyebrow eyebrow--cyan mono">{c.aboutEyebrow}</div>
    <h2>{c.aboutTitle}</h2>
  </div>
  <div class="about-body">
    <p class="about-p">{c.summary}</p>

    <div class="about-tech">
      <h3>{c.techTitle}</h3>
      <div class="about-tags">
        {techs.map((tech) => <span class="tag">{tech}</span>)}
      </div>
    </div>

    <div class="cert-card">
      <a href="https://www.credly.com/badges/54c0f470-be7b-4962-b5ba-f2bcdd13ee21/public_url" target="_blank" rel="noopener noreferrer">
        <img src="/astronomer-certification-for-apache-airflow-3-funda.png" alt="" width="48" height="48" />
      </a>
      <div>
        <div class="cert-title">Apache Airflow 3 Fundamentals</div>
        <div class="cert-issuer mono">Astronomer {c.certifications}</div>
      </div>
    </div>

    
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 1;
    min-height: 80vh;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    padding: 64px 48px;
    max-width: 1200px;
    margin: 0 auto;
    gap: 56px;
    overflow: hidden;
  }

  .hero-ring {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-ring--pink {
    top: -80px;
    right: -80px;
    width: 420px;
    height: 420px;
    border: 1px solid var(--accent-pink-faint);
    animation: ringspin 60s linear infinite;
  }

  .hero-ring--cyan {
    top: -20px;
    right: 20px;
    width: 300px;
    height: 300px;
    border: 1px solid var(--accent-cyan-faint);
    animation: ringspinrev 50s linear infinite;
  }

  @keyframes ringspin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes ringspinrev {
    from { transform: rotate(0deg); }
    to { transform: rotate(-360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-ring--pink,
    .hero-ring--cyan {
      animation: none;
    }
  }

  .hero-copy {
    flex: 1;
    min-width: 280px;
  }

  .hero-copy h1 {
    font-size: 3.3em;
    line-height: 1.05;
    margin: 0 0 24px;
  }

  .hero-desc {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 560px;
    margin: 0 0 36px;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 40px;
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .hero-photo {
    width: 260px;
    flex-shrink: 0;
    position: relative;
    margin: 0 auto;
  }

  .hero-photo-dashed {
    position: absolute;
    inset: -14px;
    border-radius: 50%;
    border: 1px dashed var(--accent-pink-faint-2);
  }

  .hero-photo img {
    width: 260px;
    height: 260px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }

  .about {
    display: flex;
    gap: 56px;
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .about-heading {
    width: 240px;
    flex-shrink: 0;
  }

  .about-heading h2 {
    font-size: 2em;
    margin: 0;
  }

  .about-body {
    flex: 1;
    min-width: 280px;
    max-width: 680px;
  }

  .about-p {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-muted);
    margin: 0 0 32px;
  }

  .about-tech h3 {
    font-size: 1.1em;
    margin: 0 0 16px;
  }

  .about-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 32px;
  }

  .cert-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 22px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg-panel);
    margin-bottom: 32px;
  }

  .cert-card img {
    border-radius: 50%;
    flex-shrink: 0;
  }

  .cert-title {
    font-size: 14px;
    font-weight: 600;
  }

  .cert-issuer {
    font-size: 12px;
    color: var(--text-dim);
    margin-top: 2px;
  }

  .about-socials {
    display: flex;
    gap: 1rem;
  }

  .about-socials a {
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .about-socials a:hover {
    color: var(--accent-pink);
  }

  @media (max-width: 720px) {
    .hero {
      padding: 48px 24px;
      justify-content: center;
      text-align: center;
    }

    .hero-copy h1 {
      font-size: 2.4em;
    }

    .hero-desc {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-ctas,
    .hero-tags {
      justify-content: center;
    }

    .about {
      flex-direction: column;
      gap: 24px;
    }
  }
</style>
