---
import { Image } from 'astro:assets';
import profilePhoto from '../assets/profile-photo.jpeg';
import airflowCert from '../assets/astronomer-certification-for-apache-airflow-3-funda.png';

interface Props {
  lang: string;
}

const { lang } = Astro.props;

const content = {
  en: {
    eyebrow: '// software engineer',
    jobTitle: 'Software Engineer',

    summary:
      'Software Engineer with a background in Civil Engineering and a Master’s in Structural Dynamics. I build software around data — designing backend services, data platforms, cloud infrastructure and automation. I use AI as a tool when it solves real problems, not as the centre of the solution.',

    aboutP1:
      "I hold a degree in Civil Engineering and a Master's in Structural Dynamics from UERJ. Since 2021 I've been working in software, specialising in Data Engineering while building experience across backend development, cloud infrastructure, APIs, automation and modern data platforms. My background combines postgraduate studies in Artificial Intelligence and Data Engineering at Infnet with hands-on experience delivering production systems.",

    aboutP2:
      "I'm interested in how systems behave as a whole rather than in isolated technologies. Whether building a backend service, a data pipeline or a cloud architecture, I enjoy designing solutions that are reliable, maintainable and simple. AI is part of my toolbox, but software engineering is the foundation of everything I build.",

    ctaPrimary: 'View projects',
    ctaSecondary: 'Get in touch',

    photoAlt: 'Nathalia Castelo Branco',

    aboutEyebrow: '01 / about',
    aboutTitle: 'About me',
    techTitle: 'Main Technologies',
    certifications: 'Certifications'
  },

  'pt-br': {
    eyebrow: '// engenheira de software',
    jobTitle: 'Engenheira de Software',

    summary:
      'Engenheira de Software formada em Engenharia Civil, com mestrado em Dinâmica das Estruturas. Desenvolvo software orientado a dados, unindo backend, engenharia de dados, infraestrutura em nuvem e automação. Utilizo IA como ferramenta quando ela resolve um problema real — não como o centro da solução.',

    aboutP1:
      'Sou formada em Engenharia Civil, com mestrado em Dinâmica das Estruturas pela UERJ. Desde 2021 atuo com desenvolvimento de software, especializando-me em Engenharia de Dados e ampliando minha experiência em backend, infraestrutura em nuvem, APIs, automação e plataformas de dados. Minha formação inclui pós-graduações em Inteligência Artificial e Engenharia de Dados pelo Infnet, aliadas à experiência prática no desenvolvimento de sistemas em produção.',

    aboutP2:
      'Gosto de pensar em sistemas como um todo, e não apenas em tecnologias isoladas. Seja desenvolvendo um backend, uma plataforma de dados ou uma arquitetura em nuvem, meu objetivo é construir soluções simples, confiáveis e fáceis de evoluir. IA faz parte das ferramentas que utilizo, mas engenharia de software é a base do meu trabalho.',

    ctaPrimary: 'Ver projetos',
    ctaSecondary: 'Falar comigo',

    photoAlt: 'Nathalia Castelo Branco',

    aboutEyebrow: '01 / sobre',
    aboutTitle: 'Quem sou eu',
    techTitle: 'Principais Tecnologias',
    certifications: 'Certificações'
  }
};

const c = content[lang as keyof typeof content] || content['en'];
const techs = [
  'Python',
  'Google Cloud',
  'Docker',
  'SQL',
  'Data Engineering'
];
---

<section id="home" class="hero">
  <div class="hero-ring hero-ring--pink"></div>
  <div class="hero-ring hero-ring--cyan"></div>
  <div class="hero-copy">
    <div class="eyebrow eyebrow--pink mono">{c.eyebrow}</div>
    <h1>Nathalia<br />Castelo Branco</h1>
    <p class="hero-desc">{c.summary}</p>
    <div class="hero-ctas">
      <a href="#projects" class="btn btn--primary">{c.ctaPrimary}</a>
      <a href="#contact" class="btn btn--secondary">{c.ctaSecondary}</a>
    </div>
    <div class="hero-tags">
      {techs.map((tech) => <span class="tag">{tech}</span>)}
    </div>
  </div>
  <div class="hero-photo">
    <div class="hero-photo-dashed"></div>
    <Image src={profilePhoto} alt={c.photoAlt} width={520} height={520} loading="eager" fetchpriority="high" />
  </div>
</section>

<section id="about" class="section about">
  <div class="about-heading">
    <div class="eyebrow eyebrow--cyan mono">{c.aboutEyebrow}</div>
    <h2>{c.aboutTitle}</h2>
  </div>
  <div class="about-body">
    <p class="about-p">{c.aboutP1}</p>
    <p class="about-p">{c.aboutP2}</p>

    <div class="about-tech">
      <h3>{c.techTitle}</h3>
      <div class="about-tags">
        {techs.map((tech) => <span class="tag">{tech}</span>)}
      </div>
    </div>

    <div class="cert-card">
      <a href="https://www.credly.com/badges/54c0f470-be7b-4962-b5ba-f2bcdd13ee21/public_url" target="_blank" rel="noopener noreferrer" aria-label="Apache Airflow 3 Fundamentals Certification Badge on Credly">
        <Image src={airflowCert} alt="Apache Airflow 3 Fundamentals Certification Badge" width={48} height={48} />
      </a>
      <div>
        <div class="cert-title">Apache Airflow 3 Fundamentals</div>
        <div class="cert-issuer mono">Astronomer {c.certifications}</div>
      </div>
    </div>

    
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 1;
    min-height: 80vh;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    padding: 64px 48px;
    max-width: 1200px;
    margin: 0 auto;
    gap: 56px;
    overflow: hidden;
  }

  .hero-ring {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-ring--pink {
    top: -80px;
    right: -80px;
    width: 420px;
    height: 420px;
    border: 1px solid var(--accent-pink-faint);
    animation: ringspin 60s linear infinite;
  }

  .hero-ring--cyan {
    top: -20px;
    right: 20px;
    width: 300px;
    height: 300px;
    border: 1px solid var(--accent-cyan-faint);
    animation: ringspinrev 50s linear infinite;
  }

  @keyframes ringspin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes ringspinrev {
    from { transform: rotate(0deg); }
    to { transform: rotate(-360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-ring--pink,
    .hero-ring--cyan {
      animation: none;
    }
  }

  .hero-copy {
    flex: 1;
    min-width: 280px;
  }

  .hero-copy h1 {
    font-size: 3.3em;
    line-height: 1.05;
    margin: 0 0 24px;
  }

  .hero-desc {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 560px;
    margin: 0 0 36px;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 40px;
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .hero-photo {
    width: 260px;
    flex-shrink: 0;
    position: relative;
    margin: 0 auto;
  }

  .hero-photo-dashed {
    position: absolute;
    inset: -14px;
    border-radius: 50%;
    border: 1px dashed var(--accent-pink-faint-2);
  }

  .hero-photo img {
    width: 260px;
    height: 260px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }

  .about {
    display: flex;
    gap: 56px;
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .about-heading {
    width: 240px;
    flex-shrink: 0;
  }

  .about-heading h2 {
    font-size: 2em;
    margin: 0;
  }

  .about-body {
    flex: 1;
    min-width: 280px;
    max-width: 680px;
  }

  .about-p {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-muted);
    margin: 0 0 32px;
  }

  .about-tech h3 {
    font-size: 1.1em;
    margin: 0 0 16px;
  }

  .about-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 32px;
  }

  .cert-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 22px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg-panel);
    margin-bottom: 32px;
  }

  .cert-card img {
    border-radius: 50%;
    flex-shrink: 0;
  }

  .cert-title {
    font-size: 14px;
    font-weight: 600;
  }

  .cert-issuer {
    font-size: 12px;
    color: var(--text-dim);
    margin-top: 2px;
  }

  .about-socials {
    display: flex;
    gap: 1rem;
  }

  .about-socials a {
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .about-socials a:hover {
    color: var(--accent-pink);
  }

  @media (max-width: 720px) {
    .hero {
      padding: 48px 24px;
      justify-content: center;
      text-align: center;
    }

    .hero-copy h1 {
      font-size: 2.4em;
    }

    .hero-desc {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-ctas,
    .hero-tags {
      justify-content: center;
    }

    .about {
      flex-direction: column;
      gap: 24px;
    }
  }
</style>
