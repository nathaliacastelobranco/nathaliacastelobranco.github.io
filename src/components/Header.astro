---
import { SITE_TITLE } from '../consts';
import { t } from '../i18n.ts';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import BackToTop from './BackToTop.astro';

const { lang } = Astro.props;
const pathname = Astro.url.pathname;

const isHome = pathname === `/${lang}/` || pathname === `/${lang}`;
const isBlog = pathname.startsWith(`/${lang}/blog`);
const isProjects = pathname.startsWith(`/${lang}/projects`);

const navLinks = [
	{ href: `/${lang}/`, label: t(lang, 'home'), active: isHome },
	{ href: `/${lang}/#about`, label: t(lang, 'about'), active: false },
	{ href: `/${lang}/#projects`, label: t(lang, 'projects'), active: isProjects },
	{ href: `/${lang}/blog`, label: t(lang, 'blog'), active: isBlog },
	{ href: `/${lang}/#contact`, label: t(lang, 'contact'), active: false },
];
---

<div class="floating-controls">
	<ThemeToggle />
	<LanguageSwitcher lang={lang} />
	<BackToTop />
</div>

<header>
	<nav>
		<a href={`/${lang}/`} class="logo-link" aria-label={SITE_TITLE}>
			<span class="logo-ring">
				<span class="logo-ring-inner"></span>
			</span>
			NCB
		</a>
		<button class="hamburger" id="hamburger" aria-label="Menu" aria-expanded="false" aria-controls="internal-links">
			<svg width="22" height="22" viewBox="0 0 24 24" fill="none">
				<path d="M3 12h18M3 6h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
			</svg>
		</button>
		<div class="internal-links" id="internal-links">
			{navLinks.map((link) => (
				<a href={link.href} class={link.active ? 'active' : ''} aria-current={link.active ? 'page' : undefined}>{link.label}</a>
			))}
		</div>
	</nav>
</header>

<script>
	const hamburger = document.getElementById('hamburger');
	const menu = document.getElementById('internal-links');

	hamburger?.addEventListener('click', () => {
		const expanded = hamburger.getAttribute('aria-expanded') === 'true';
		hamburger.setAttribute('aria-expanded', String(!expanded));
		menu?.classList.toggle('open');
	});
</script>

<style>
	.floating-controls {
		position: fixed;
		top: 50%;
		right: 20px;
		transform: translateY(-50%);
		z-index: 200;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	@media (max-width: 720px) {
		.floating-controls {
			top: auto;
			bottom: 16px;
			right: 16px;
			transform: none;
			flex-direction: row;
		}
	}

	header {
		position: sticky;
		top: 0;
		z-index: 50;
		margin: 0;
		background: var(--nav-bg);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--border);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 18px 48px;
		max-width: 1200px;
		margin: 0 auto;
	}

	.logo-link {
		display: flex;
		align-items: center;
		gap: 10px;
		font-family: var(--font-mono);
		font-size: 15px;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: var(--text);
	}

	.logo-ring {
		width: 20px;
		height: 20px;
		border-radius: 50%;
		border: 1.5px solid var(--accent-pink);
		display: inline-flex;
		position: relative;
	}

	.logo-ring-inner {
		position: absolute;
		inset: 4px;
		border-radius: 50%;
		border: 1px solid var(--accent-pink-dim);
	}

	.internal-links {
		display: flex;
		gap: 32px;
		font-family: var(--font-mono);
		font-size: 13px;
		letter-spacing: 0.03em;
		text-transform: uppercase;
	}

	.internal-links a {
		color: var(--text-dim);
	}

	.internal-links a.active {
		color: var(--text);
	}

	.hamburger {
		display: none;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.5rem;
		align-items: center;
		justify-content: center;
		color: var(--text);
	}

	@media (max-width: 768px) {
		nav {
			padding: 16px 24px;
		}

		.hamburger {
			display: flex;
		}

		.internal-links {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			background: var(--nav-bg);
			backdrop-filter: blur(10px);
			border-bottom: 1px solid var(--border);
			flex-direction: column;
			gap: 0;
			padding: 0.5rem 0;
		}

		.internal-links.open {
			display: flex;
		}

		.internal-links a {
			padding: 0.9rem 1.5rem;
		}

		nav {
			position: relative;
		}
	}
</style>
