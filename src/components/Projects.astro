---
import { t } from '../i18n.ts';
import { projects } from '../data/projects.ts';

interface Props {
	lang: 'en' | 'pt-br';
}

const { lang } = Astro.props;
const placeholderLabel = lang === 'pt-br' ? 'Imagem do projeto' : 'Project image';
---

<section id="projects" class="section">
	<div class="eyebrow eyebrow--pink mono">{t(lang, 'projectsEyebrow')}</div>
	<h2>{t(lang, 'projectsTitle')}</h2>

	<div class="projects-grid">
		{projects.map((project) => {
			const copy = project.copy[lang];
			return (
				<article class="project-card">
					<div class="project-image" role="img" aria-label={placeholderLabel}>
						{placeholderLabel}
					</div>
					<div class="project-body">
						<div class="project-tags">
							{project.tags.map((tag) => <span class="tag tag--cyan">{tag}</span>)}
						</div>
						<h3>{copy.title}</h3>
						<p class="project-desc">{copy.description}</p>
						<a href={`/${lang}/projects/${project.slug}/`} class="project-link mono">{t(lang, 'viewDetails')}</a>
					</div>
				</article>
			);
		})}
	</div>
</section>

<style>
	h2 {
		font-size: 2.1em;
		margin: 0 0 48px;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.project-card {
		border: 1px solid var(--border);
		border-radius: 4px;
		overflow: hidden;
		background: var(--bg-panel);
		display: flex;
		flex-direction: column;
	}

	.project-image {
		width: 100%;
		height: 160px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--text-faint);
		background: var(--bg-panel-solid);
		border-bottom: 1px solid var(--border);
	}

	.project-body {
		padding: 22px;
	}

	.project-tags {
		display: flex;
		gap: 8px;
		margin-bottom: 12px;
	}

	.project-body h3 {
		font-size: 1.15em;
		margin: 0 0 10px;
	}

	.project-desc {
		font-size: 14px;
		line-height: 1.6;
		color: var(--text-dim);
		margin: 0 0 16px;
	}

	.project-link {
		font-size: 12px;
		color: var(--accent-pink);
	}

	@media (max-width: 900px) {
		.projects-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
